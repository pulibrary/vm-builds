{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned pip installs inside the Ansible control images",
      "managerFilePatterns": ["/^docker/.+/Dockerfile$/"],
      "matchStrings": ["(?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[0-9][^\\s\\\\]*)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold ansible-core below 2.22 while the project supports Python 3.12: ansible-core 2.22 requires Python >= 3.13. Lift this together with requires-python",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.22"
    },
    {
      "description": "Each Ubuntu Dockerfile is tied to its release's package pins, so only refresh the base image digest",
      "matchFileNames": ["docker/ubuntu/*/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "The Rocky and AlmaLinux Dockerfiles look up their rpm pins in the EL10 repos, so a new EL major is moved to by hand; only refresh within the release",
      "matchFileNames": ["docker/rocky/Dockerfile", "docker/almalinux/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rockylinux/rockylinux", "almalinux"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Look up the Ubuntu 22.04 image's apt pins in jammy and its update pockets",
      "matchFileNames": ["docker/ubuntu/22.04/Dockerfile"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://archive.ubuntu.com/ubuntu?suite=jammy&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=jammy-updates&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=jammy-security&components=main,universe&binaryArch=amd64"
      ]
    },
    {
      "description": "Look up the Ubuntu 24.04 image's apt pins in noble and its update pockets",
      "matchFileNames": ["docker/ubuntu/24.04/Dockerfile"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://archive.ubuntu.com/ubuntu?suite=noble&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=noble-updates&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=noble-security&components=main,universe&binaryArch=amd64"
      ]
    },
    {
      "description": "Look up the Ubuntu 26.04 image's apt pins in resolute and its update pockets",
      "matchFileNames": ["docker/ubuntu/26.04/Dockerfile"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://archive.ubuntu.com/ubuntu?suite=resolute&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=resolute-updates&components=main,universe&binaryArch=amd64",
        "https://archive.ubuntu.com/ubuntu?suite=resolute-security&components=main,universe&binaryArch=amd64"
      ]
    },
    {
      "description": "Bump Ubuntu 22.04's pip on its own branch: once pip drops Python 3.10 the image build fails, and that must not hold back the grouped updates. Strict constraintsFiltering cannot guard this because Renovate's pep440 versioning has no range subset check, so it rejects every release that declares requires_python",
      "matchFileNames": ["docker/ubuntu/22.04/Dockerfile"],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["pip"],
      "groupName": "pip for Ubuntu 22.04"
    }
  ]
}
