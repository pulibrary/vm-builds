{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned pip installs inside the Ansible control images",
      "managerFilePatterns": ["/^docker/.+/Dockerfile$/"],
      "matchStrings": ["(?<depName>[a-zA-Z0-9._-]+)==(?<currentValue>[0-9][^\\s\\\\]*)"],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Only propose ansible-core releases this project's Python floor can install",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["ansible-core"],
      "ignoreUnstable": true
    }
  ]
}
