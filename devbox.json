{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "packer": "latest",
    "python": {
      "version": "3.13",
      "disable_plugin": true
    },
    "uv": "0.12.5",
    "awscli2": "2.35.11",
    "just": "latest",
    "git": "latest",
    "qemu": "latest",
    "google-cloud-sdk": "latest"
  },
  "env": {
    "PATH": "$DEVBOX_PROJECT_ROOT/.venv/bin:$PATH",
    "VIRTUAL_ENV": "$DEVBOX_PROJECT_ROOT/.venv",
    "UV_PROJECT_ENVIRONMENT": "$DEVBOX_PROJECT_ROOT/.venv",
    "UV_PYTHON": "3.13",
    "UV_PYTHON_PREFERENCE": "managed"
  },
  "shell": {
    "init_hook": [
      "echo 'Run \"devbox run init\" to set up the Python environment'"
    ],
    "scripts": {
      "init": [
        "uv sync --frozen",
        "test -d .venv && echo 'Virtual environment ready' || echo 'Failed to create virtual environment'"
      ],
      "update-deps": [
        "uv lock --upgrade",
        "uv sync"
      ],
      "lock": [
        "uv lock"
      ],
      "clean": [
        "rm -rf .venv",
        "rm -rf .devbox"
      ],
      "test": [
        "uv run --frozen ansible --version",
        "uv run --frozen ansible-lint --version",
        "packer version"
      ]
    }
  }
}
