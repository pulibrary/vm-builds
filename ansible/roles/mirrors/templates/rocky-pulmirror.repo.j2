# {{ ansible_managed }}
# Preferred Rocky Linux mirrors (PUL) — additive, does not disable stock repos.
# Served from https://{{ pul_mirror_host }}/mirror/rocky/

[rocky-baseos-pul]
name=Rocky Linux $releasever - BaseOS (PUL)
baseurl=https://{{ pul_mirror_host }}/mirror/rocky/$releasever/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-$releasever
skip_if_unavailable=True
cost=10

[rocky-appstream-pul]
name=Rocky Linux $releasever - AppStream (PUL)
